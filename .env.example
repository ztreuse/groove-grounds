# Copy this file to .env.local and fill in the values from your Supabase
# project (Dashboard → Connect, and Project Settings → API Keys).
# Never commit .env.local.

# Transaction pooler connection string (port 6543). Used by the app.
DATABASE_URL="postgresql://postgres.your-project-ref:your-db-password@aws-0-your-region.pooler.supabase.com:6543/postgres"

# Session pooler connection string (port 5432). Used for migrations and seeding.
DIRECT_URL="postgresql://postgres.your-project-ref:your-db-password@aws-0-your-region.pooler.supabase.com:5432/postgres"

# Project URL and publishable key. Used by Supabase Auth and Realtime in later steps.
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_your-key"

# Demo dancer account behind "Try the demo dancer" on the sign-in page.
# Pick any email and a long random password; `npm run db:seed-demo` creates it.
DEMO_DANCER_EMAIL="demo-dancer@example.com"
DEMO_DANCER_PASSWORD="a-long-random-password"
